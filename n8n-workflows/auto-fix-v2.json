    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      },
      {
       "name": "content-type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({\"model\": \"claude-sonnet-4-6\", \"max_tokens\": 2000, \"messages\": [{\"role\": \"user\", \"content\": \"Fix this GitHub issue. Title: \" + $json.issue.title + \"\\nBody: \" + ($json.issue.body || \"\") + \"\\nRespond ONLY with JSON: {\\\"filePath\\\": \\\"<the file to fix\\\", \\\"fileContent\\\": \\\"<full corrected file content>\\\"}. Use README.md if no file is clearly affected. No markdown fences, no explanation.\"}]}) }}",
    "options": {}
   },
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "position": [
    48,
    112
   ],
   "id": "821508e3-ed83-47d7-92b4-fe819cd65e71",
   "name": "Call Claude",
   "credentials": {
    "httpHeaderAuth": {
     "id": "vmEZSyYga20sqPgZ",
     "name": "Header Auth account"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const raw = $input.first().json.content[0].text;\nlet t = raw.trim();\nif (t.startsWith('```')) { t = t.replace(/^```(json)?\\s*/, '').replace(/\\s*```$/, ''); }\nconst parsed = JSON.parse(t);\nconst trig = $('GitHub Trigger').first().json;\nreturn [{ json: { branch: 'fix/auto-' + trig.issue.number, fixText: parsed.fileContent, filePath: parsed.filePath || 'README.md', issueNumber: trig.issue.number, owner: trig.repository.owner.login, repo: trig.repository.name } }];"
   },
   "name": "Parse Fix",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    304,
    32
   ],
   "id": "928da67a-c7de-4fbb-b2dc-1368669243a6"
  },
  {
