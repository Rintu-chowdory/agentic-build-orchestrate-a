{
 "name": "CI Watchdog",
 "nodes": [
  {
   "parameters": {
    "owner": {
     "__rl": true,
     "value": "=Rintu-chowdory",
     "mode": "name"
    },
    "repository": {
     "__rl": true,
     "mode": "name",
     "value": "=agentic-build-orchestrate-a"
    },
    "events": [
     "workflow_run"
    ],
    "options": {}
   },
   "name": "GitHub Trigger",
   "type": "n8n-nodes-base.githubTrigger",
   "typeVersion": 1,
   "position": [
    -560,
    112
   ],
   "id": "33330001-0000-4000-8000-000000000001",
   "webhookId": "33330001-0000-4000-8000-0000000000ff",
   "credentials": {
    "githubApi": {
     "id": "dAjZFYhSr9DSzzjO",
     "name": "GitHub account"
    }
   }
  },
  {
   "parameters": {
    "conditions": {
     "string": [
      {
       "value1": "={{$json.action}}",
       "value2": "completed"
      },
      {
       "value1": "={{ $json.workflow_run.conclusion }}",
       "value2": "failure"
      }
     ]
    }
   },
   "name": "IF Failed",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    -320,
    112
   ],
   "id": "33330001-0000-4000-8000-000000000002"
  },
  {
   "parameters": {
    "conditions": {
     "string": [
      {
       "value1": "={{ ($json.workflow_run.pull_requests || []).length > 0 ? 'yes' : 'no' }}",
       "value2": "yes"
      }
     ]
    }
   },
   "name": "Has PR?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    -80,
    112
   ],
   "id": "33330001-0000-4000-8000-000000000003"
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=https://api.github.com/repos/{{$('GitHub Trigger').first().json.repository.owner.login}}/{{$('GitHub Trigger').first().json.repository.name}}/issues/{{$('GitHub Trigger').first().json.workflow_run.pull_requests[0].number}}/comments",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "githubApi",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ body: '⚠️ CI failed on branch `' + $('GitHub Trigger').first().json.workflow_run.head_branch + '`. Run: ' + $('GitHub Trigger').first().json.workflow_run.html_url }) }}",
    "options": {}
   },
   "name": "Comment on PR",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    176,
    32
   ],
   "id": "33330001-0000-4000-8000-000000000004",
   "credentials": {
    "githubApi": {
     "id": "dAjZFYhSr9DSzzjO",
     "name": "GitHub account"
    }
   }
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=https://api.github.com/repos/{{$('GitHub Trigger').first().json.repository.owner.login}}/{{$('GitHub Trigger').first().json.repository.name}}/issues",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "githubApi",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ title: 'CI failed: ' + $('GitHub Trigger').first().json.workflow_run.name + ' on ' + $('GitHub Trigger').first().json.workflow_run.head_branch, body: 'The workflow **' + $('GitHub Trigger').first().json.workflow_run.name + '** failed.\\n\\nRun: ' + $('GitHub Trigger').first().json.workflow_run.html_url }) }}",
    "options": {}
   },
   "name": "Create Issue",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    176,
    192
   ],
   "id": "33330001-0000-4000-8000-000000000005",
   "credentials": {
    "githubApi": {
     "id": "dAjZFYhSr9DSzzjO",
     "name": "GitHub account"
    }
   }
  }
 ],
 "pinData": {},
 "connections": {
  "GitHub Trigger": {
   "main": [
    [
     {
      "node": "IF Failed",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "IF Failed": {
   "main": [
    [
     {
      "node": "Has PR?",
      "type": "main",
      "index": 0
     }
