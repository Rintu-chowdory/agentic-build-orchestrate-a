   "name": "GitHub Trigger"
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.body && j.body.task !== undefined) {\n    out.push({ json: { task: String(j.body.task), source: 'webhook', issue_number: null } });\n  } else if (j.issue) {\n    const labels = (j.issue.labels || []).map(l => l && l.name ? l.name : l);\n    const isSquad = (j.action === 'labeled' && j.label && j.label.name === 'squad')\n      || (j.action === 'opened' && labels.includes('squad'));\n    if (!isSquad) continue;\n    out.push({ json: { task: j.issue.title + '\\n\\n' + (j.issue.body || ''), source: 'github', issue_number: j.issue.number } });\n  }\n}\nreturn out;"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -384,
    -24
   ],
   "id": "a0000001-0000-4000-8000-000000000003",
   "name": "Normalize Input"
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "=Task:\n{{ $json.task }}",
    "messages": {
     "values": [
      {
       "role": "system",
       "content": "You are a task router for an agent team. Given a task, decide which specialist agents handle it and what each should do.\nAvailable agents:\n- rintu/dev_ops_agent - CI/CD, Docker, pipelines, infrastructure, DevOps\n- rintu/security_audit_agent - security review, vulnerabilities, threat analysis\n- rintu/saas_idea_agent - product/SaaS ideas, market analysis\n- rintu/base44_builder_agent - building apps on Base44, web app planning\nRules: pick 1-3 agents most relevant to the task; if none clearly fits, use rintu/dev_ops_agent. Write each agent's subtask as a complete, self-contained instruction in English.\nRespond ONLY with compact JSON, no markdown fences:\n{\"agents\":[{\"id\":\"rintu/dev_ops_agent\",\"task\":\"<specific instruction>\"}]}"
      }
     ]
    },
    "options": {}
   },
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    -144,
    -24
   ],
   "id": "a0000001-0000-4000-8000-000000000004",
   "name": "Route Task",
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 30000
  },
  {
   "parameters": {
    "model": {
     "__rl": true,
     "value": "deepseek/deepseek-v4-flash-0731:free",
     "mode": "list"
    },
    "options": {
     "temperature": 0.1
    }
   },
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1,
   "position": [
    -144,
    -200
   ],
   "id": "a0000001-0000-4000-8000-000000000005",
   "name": "Router Model (OpenRouter)",
   "credentials": {
    "openAiApi": {
     "id": "REPLACE_AFTER_IMPORT",
     "name": "OpenRouter"
    }
   }
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const base = $('Normalize Input').first().json;\nlet plan;\ntry {\n  let raw = ($json.text || '').replace(/```(json)?/g, '').trim();\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  plan = JSON.parse(m ? m[0] : raw);\n} catch (e) {\n  plan = null;\n}\nlet agents = plan && Array.isArray(plan.agents) ? plan.agents : [];\nagents = agents.filter(a => a && a.id && String(a.id).startsWith('rintu/')).slice(0, 3);\nif (!agents.length) agents = [{ id: 'rintu/dev_ops_agent', task: base.task }];\nreturn agents.map(a => ({ json: {\n  agent: a.id,\n  subtask: a.task || base.task,\n  task: base.task,\n  source: base.source,\n  issue_number: base.issue_number,\n} }));"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    80,
    -24
   ],
   "id": "a0000001-0000-4000-8000-000000000006",
   "name": "Parse Routing"
  },
  {
