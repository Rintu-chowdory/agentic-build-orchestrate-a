    "url": "https://openagi-agent-api.onrender.com/run",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-API-Key",
       "value": "REPLACE_AGENT_API_KEY"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ agent: $json.agent, task: $json.subtask }) }}",
    "options": {
     "timeout": 300000
    }
   },
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    304,
    -24
   ],
   "id": "a0000001-0000-4000-8000-000000000007",
   "name": "Run Agent",
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const base = $('Normalize Input').first().json;\nconst MAX = 2500;\nconst results = $input.all().map(i => {\n  const j = i.json || {};\n  let r;\n  if (j.result !== undefined) r = typeof j.result === 'string' ? j.result : JSON.stringify(j.result);\n  else r = j.error ? ('Agent failed: ' + JSON.stringify(j.error)) : 'Agent returned no result';\n  if (r.length > MAX) r = r.slice(0, MAX) + '...[truncated]';\n  return { agent: j.agent || 'unknown', result: r };\n});\nreturn [{ json: { task: base.task, source: base.source, issue_number: base.issue_number, results } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    528,
    -24
   ],
   "id": "a0000001-0000-4000-8000-000000000008",
