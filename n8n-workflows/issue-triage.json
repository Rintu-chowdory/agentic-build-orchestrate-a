   "credentials": {
    "githubApi": {
     "id": "dAjZFYhSr9DSzzjO",
     "name": "GitHub account"
    }
   }
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=https://api.github.com/repos/{{$('Classify').item.json.owner}}/{{$('Classify').item.json.repo}}/issues/{{$('Classify').item.json.issueNumber}}/comments",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "githubApi",
