   "name": "IF Opened",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    -176,
    112
   ],
   "id": "22220001-0000-4000-8000-000000000002"
  },
  {
   "parameters": {
    "jsCode": "const t = $('GitHub Trigger').first().json.issue;\nconst text = ((t.title || '') + ' ' + (t.body || '')).toLowerCase();\nlet kind = 'question';\nif (/\\b(bug|error|crash|broken|fail|exception|doesn't work|doesnt work)\\b/.test(text)) kind = 'bug';\nelse if (/\\b(doc|documentation|readme|typo|spelling)\\b/.test(text)) kind = 'documentation';\nelse if (/\\b(feature|enhancement|request|improve|add support)\\b/.test(text)) kind = 'enhancement';\nconst trig = $('GitHub Trigger').first().json;\nreturn [{ json: { kind, labels: [kind], issueNumber: trig.issue.number, owner: trig.repository.owner.login, repo: trig.repository.name } }];"
   },
   "name": "Classify",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    48,
    112
   ],
   "id": "22220001-0000-4000-8000-000000000003"
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/issues/{{$json.issueNumber}}/labels",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "githubApi",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ labels: $json.labels }) }}",
    "options": {}
   },
   "name": "Add Labels",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
