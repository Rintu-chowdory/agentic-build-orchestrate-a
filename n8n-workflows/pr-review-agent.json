      "parameters": {
        "url": "=https://api.github.com/repos/{{$('GitHub Trigger').first().json.repository.owner.login}}/{{$('GitHub Trigger').first().json.repository.name}}/pulls/{{$('GitHub Trigger').first().json.pull_request.number}}",
